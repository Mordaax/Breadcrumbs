{
  "name": "rcca",
  "version": "0.1.0",
  "description": "Rocket.Chat Code Analyzer — dependency-aware context packing to reduce agentic inference context for large TypeScript monorepos.",
  "type": "module",
  "bin": {
    "rcca": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx src/cli.ts",
    "rcca": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:built": "npm run build && node --test dist/../test-built/*.test.js"
  },
  "keywords": [
    "rocket.chat",
    "context",
    "dependency-graph",
    "llm",
    "agent",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
